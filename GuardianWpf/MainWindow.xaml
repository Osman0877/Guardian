<Window x:Class="GuardianWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Guardian — Windows Parental Controls"
        Height="780" Width="1180" MinHeight="650" MinWidth="950"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Background="{StaticResource BgDarkBrush}"
        Foreground="White">

    <Border BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" Background="{StaticResource SurfaceDarkBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Header & Global Search Bar -->
            <Grid Grid.Row="0" Background="{StaticResource BgDarkBrush}" MouseDown="TitleBar_MouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand Logo & Mode Badge -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                    <TextBlock Text="🛡️" FontSize="20" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="GUARDIAN" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentBlueBrush}" VerticalAlignment="Center"/>
                    <Border x:Name="ActiveRoleBadge" Background="{StaticResource CardDarkBrush}" CornerRadius="6" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="ActiveRoleBadgeText" Text="PARENT MODE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource SuccessGreenBrush}"/>
                    </Border>
                </StackPanel>

                <!-- Center: Global Search Bar + Switch Mode Button -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0">
                    <TextBox x:Name="GlobalSearchBox" Style="{StaticResource ModernTextBoxStyle}" Width="320" Height="32" Padding="8,4" Tag="🔍 Global search (Apps, Schedules, Rules...)" TextChanged="GlobalSearchBox_TextChanged"/>
                    <Button x:Name="SwitchModeButton" Content="🔄 Switch to Child Mode" Style="{StaticResource OutlineButtonStyle}" Margin="16,0,0,0" Padding="12,4" FontSize="12" Click="SwitchMode_Click"/>
                </StackPanel>

                <!-- Window Control Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                    <Button Content="🗕" Width="36" Height="30" Background="Transparent" Foreground="White" BorderThickness="0" Cursor="Hand" Click="Minimize_Click"/>
                    <Button Content="🗖" Width="36" Height="30" Background="Transparent" Foreground="White" BorderThickness="0" Cursor="Hand" Click="Maximize_Click"/>
                    <Button Content="✕" Width="36" Height="30" Background="Transparent" Foreground="{StaticResource DangerRedBrush}" BorderThickness="0" Cursor="Hand" Click="Close_Click"/>
                </StackPanel>
            </Grid>

            <!-- Main Workspace: Sidebar Navigation + Content Area -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Sidebar Navigation -->
                <Border Grid.Column="0" Background="{StaticResource BgDarkBrush}" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Scrollable Parent Navigation Items (13 Items) -->
                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="12,12,12,6">
                                <!-- Parent Navigation Panel -->
                                <StackPanel x:Name="ParentNavPanel">
                                    <RadioButton x:Name="NavDashboard" Content="🏠  Dashboard" Style="{StaticResource NavButtonStyle}" IsChecked="True" Click="Nav_Click"/>
                                    <RadioButton x:Name="NavScreenTime" Content="⏰  Screen Time" Style="{StaticResource NavButtonStyle}" Click="Nav_Click"/>
                                    <RadioButton x:Name="NavAppBlocking" Content="📱  App Blocking" Style="{StaticResource NavButtonStyle}" Click="Nav_Click"/>
                                    <RadioButton x:Name="NavApplications" Content="📋  Applications" Style="{StaticResource NavButtonStyle}" Click="Nav_Click"/>
                                    <RadioButton x:Name="NavWebProtection" Content="🌐  Web Protection" Style="{StaticResource NavButtonStyle}" Click="Nav_Click"/>
                                    <RadioButton x:Name="NavSchedules" Content="📅  Schedules" Style="{StaticResource NavButtonStyle}" Click="Nav_Click"/>
                                    <RadioButton x:Name="NavAfkLog" Content="🕒  AFK Log" Style="{StaticResource NavButtonStyle}" Click="Nav_Click"/>
                                    <RadioButton x:Name="NavRequests" Content="📨  Time Requests" Style="{StaticResource NavButtonStyle}" Click="Nav_Click"/>
                                    <RadioButton x:Name="NavActivity" Content="📊  Activity" Style="{StaticResource NavButtonStyle}" Click="Nav_Click"/>
                                    <RadioButton x:Name="NavReports" Content="📈  Reports" Style="{StaticResource NavButtonStyle}" Click="Nav_Click"/>
                                    <RadioButton x:Name="NavNotifications" Content="🔔  Notifications" Style="{StaticResource NavButtonStyle}" Click="Nav_Click"/>
                                    <RadioButton x:Name="NavProtection" Content="🛡️  Protection" Style="{StaticResource NavButtonStyle}" Click="Nav_Click"/>
                                    <RadioButton x:Name="NavChildren" Content="👨‍👩‍👧  Children" Style="{StaticResource NavButtonStyle}" Click="Nav_Click"/>
                                    <RadioButton x:Name="NavSettings" Content="⚙️  Settings" Style="{StaticResource NavButtonStyle}" Click="Nav_Click"/>
                                </StackPanel>

                                <!-- Child Navigation Panel (Requirement #5) -->
                                <StackPanel x:Name="ChildNavPanel" Visibility="Collapsed">
                                    <RadioButton x:Name="NavChildHome" Content="🏠  Home" Style="{StaticResource NavButtonStyle}" IsChecked="True" Click="ChildNav_Click"/>
                                    <RadioButton x:Name="NavChildScreenTime" Content="⏰  My Screen Time" Style="{StaticResource NavButtonStyle}" Click="ChildNav_Click"/>
                                    <RadioButton x:Name="NavChildApps" Content="📱  My Apps" Style="{StaticResource NavButtonStyle}" Click="ChildNav_Click"/>
                                    <RadioButton x:Name="NavChildRequests" Content="📨  My Requests" Style="{StaticResource NavButtonStyle}" Click="ChildNav_Click"/>
                                    <RadioButton x:Name="NavChildNotifications" Content="🔔  Notifications" Style="{StaticResource NavButtonStyle}" Click="ChildNav_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Bottom Status Card in Sidebar -->
                        <Border Grid.Row="1" Background="{StaticResource SurfaceDarkBrush}" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="0,1,0,0" Padding="14,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse x:Name="SidebarStatusDot" Width="10" Height="10" Fill="{StaticResource SuccessGreenBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Protection: 🟢 Active" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock x:Name="SidebarActiveChildText" Text="Profile: 👦 Alex" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- Main Content Host -->
                <ContentControl x:Name="MainContentHost" Grid.Column="1" Background="{StaticResource SurfaceDarkBrush}"/>
            </Grid>
        </Grid>
    </Border>
</Window>
