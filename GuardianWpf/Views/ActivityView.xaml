<UserControl x:Class="GuardianWpf.Views.ActivityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28">

            <Grid Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="📊 Activity Feed &amp; Event Stream" FontSize="24" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Chronological timeline of system enforcement, process closures, locks, and parental unlocks." FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>

                <Button Content="🔄 Refresh Feed" Style="{StaticResource OutlineButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="14,6" Click="Refresh_Click"/>
            </Grid>

            <!-- Activity Event List -->
            <Border Style="{StaticResource CardBorderStyle}">
                <ListView x:Name="ActivityListView" Background="Transparent" BorderThickness="0" Foreground="White">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="0,0,0,1" Padding="10,12" Width="700">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Timestamp -->
                                    <TextBlock Grid.Column="0" Text="{Binding FormattedTimestamp}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>

                                    <!-- Tag / Badge -->
                                    <Border Grid.Column="1" Background="{Binding BadgeBackground}" CornerRadius="4" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding EventTag}" FontSize="11" FontWeight="Bold" Foreground="{Binding BadgeForeground}"/>
                                    </Border>

                                    <!-- Description -->
                                    <TextBlock Grid.Column="2" Text="{Binding Description}" FontSize="13" Foreground="White" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
