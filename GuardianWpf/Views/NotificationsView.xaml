<UserControl x:Class="GuardianWpf.Views.NotificationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28">

            <Grid Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="🔔 Notifications &amp; System Alerts" FontSize="24" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Real-time alerts regarding screen time thresholds, application restrictions, and child requests." FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>

                <Button Content="✓ Mark All as Read" Style="{StaticResource OutlineButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="14,6" Click="MarkAllRead_Click"/>
            </Grid>

            <!-- Notifications List -->
            <Border Style="{StaticResource CardBorderStyle}">
                <ListView x:Name="NotificationsListView" Background="Transparent" BorderThickness="0" Foreground="White">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="0,0,0,1" Padding="10,14" Width="700">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="140"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Severity Icon -->
                                    <TextBlock Grid.Column="0" Text="{Binding IconString}" FontSize="20" VerticalAlignment="Center"/>

                                    <!-- Title & Message -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Bold" Foreground="White"/>
                                            <Border Visibility="{Binding UnreadVisibility}" Background="{StaticResource AccentBlueBrush}" CornerRadius="3" Padding="4,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="NEW" FontSize="9" FontWeight="Bold" Foreground="White"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Message}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <!-- Timestamp -->
                                    <TextBlock Grid.Column="2" Text="{Binding FormattedTimestamp}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
