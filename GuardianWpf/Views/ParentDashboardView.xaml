<UserControl x:Class="GuardianWpf.Views.ParentDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28">

            <!-- Title & Protection Badge -->
            <Grid Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="Parent Control Center" FontSize="26" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Authoritative real-time monitoring and parental enforcement overview" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Protection Status Badge -->
                <Border x:Name="StatusBadgeBorder" HorizontalAlignment="Right" VerticalAlignment="Center" Background="#163828" BorderBrush="{StaticResource SuccessGreenBrush}" BorderThickness="1" CornerRadius="16" Padding="14,6">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="{StaticResource SuccessGreenBrush}" Margin="0,0,8,0"/>
                        <TextBlock x:Name="StatusBadgeText" Text="PROTECTED" FontSize="12" FontWeight="Bold" Foreground="{StaticResource SuccessGreenBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Admin Privilege Alert (If running under admin) -->
            <Border x:Name="AdminWarningBanner" Background="#382510" BorderBrush="{StaticResource AccentGoldBrush}" BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="0,0,0,20" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="⚠️" FontSize="22" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Running on a Windows Administrator Account" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentGoldBrush}"/>
                        <TextBlock Text="For maximum enforcement reliability, set up your child with a Standard Windows User account so they cannot kill system processes." FontSize="12" Foreground="White" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Quick Metrics Grid -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Metric 1: Screen Time Used -->
                <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="TODAY'S SCREEN TIME" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock x:Name="ScreenTimeUsedText" Text="0h 00m" FontSize="28" FontWeight="Bold" Foreground="White" Margin="0,8,0,4"/>
                        <ProgressBar x:Name="ScreenTimeProgressBar" Height="6" Maximum="100" Value="45" Foreground="{StaticResource AccentBlueBrush}" Background="{StaticResource SurfaceDarkBrush}" BorderThickness="0" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Metric 2: Remaining Allowance -->
                <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="REMAINING TIME TODAY" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock x:Name="RemainingTimeText" Text="2h 00m" FontSize="28" FontWeight="Bold" Foreground="{StaticResource SuccessGreenBrush}" Margin="0,8,0,4"/>
                        <TextBlock x:Name="DailyLimitLabel" Text="Based on 2h 00m daily schedule" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Metric 3: Active Application -->
                <Border Grid.Column="4" Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="ACTIVE APPLICATION" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock x:Name="ActiveAppText" Text="None" FontSize="22" FontWeight="Bold" Foreground="{StaticResource AccentGoldBrush}" Margin="0,8,0,4" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="ActiveWindowTitleText" Text="Desktop" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- AFK Mode Status & Control Card -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,24" BorderBrush="{StaticResource AccentGoldBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock x:Name="AfkBadgeDot" Text="⚪" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="AfkStatusTitleText" Text="AFK MODE INACTIVE" FontSize="15" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="AfkStatusDetailText" Text="Screen time accounting is currently active." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>

                    <Button Grid.Column="1" x:Name="AfkActionButton" Content="🟢 Activate AFK Mode" Style="{StaticResource SuccessButtonStyle}" VerticalAlignment="Center" Padding="16,8" Click="AfkAction_Click"/>
                </Grid>
            </Border>

            <!-- Quick Action Bar -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="Quick Parent Actions" FontSize="15" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,12"/>
                    <WrapPanel>
                        <Button Content="➕ Grant +15 Min" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,10,8" Click="Grant15_Click"/>
                        <Button Content="➕ Grant +30 Min" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,10,8" Click="Grant30_Click"/>
                        <Button Content="➕ Grant +1 Hour" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,10,8" Click="Grant60_Click"/>
                        <Button Content="🔒 Lock Device Now" Style="{StaticResource DangerButtonStyle}" Margin="0,0,10,8" Click="InstantLock_Click"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Top Used Applications Table -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="Today's Most Used Applications" FontSize="15" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,14"/>
                    <ListView x:Name="TopAppsList" Background="Transparent" BorderThickness="0" Foreground="White" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="0,0,0,1" Padding="8,10" Width="680">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="140"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                                            <TextBlock Text="{Binding ProcessName}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding FormattedUsage}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentBlueBrush}" HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding StatusLabel}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
