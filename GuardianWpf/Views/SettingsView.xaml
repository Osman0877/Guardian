<UserControl x:Class="GuardianWpf.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28">

            <TextBlock Text="⚙️ Parent Administrator Settings" FontSize="24" FontWeight="Bold" Foreground="White"/>
            <TextBlock Text="Configure security, parent credentials, mobile web access, and protection preferences." FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,24"/>

            <!-- Parent Credentials & Account Card -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="👨‍👩‍👦 Parent Account Credentials" FontSize="16" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,4"/>
                    <TextBlock Text="Manage the master parent username and password used to log in on this PC and on the Web Dashboard." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,16"/>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Parent Username (used for Web Dashboard Login)" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="ParentUsernameInput" Text="MasterDad" Style="{StaticResource ModernTextBoxStyle}"/>
                        </StackPanel>

                        <Button Grid.Column="2" Content="Save Username" Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Bottom" Padding="14,10" Click="SaveUsername_Click"/>
                    </Grid>

                    <Separator Background="{StaticResource BorderDarkBrush}" Margin="0,4,0,14"/>

                    <TextBlock Text="Parent Password Security" FontSize="14" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,4"/>
                    <TextBlock x:Name="PasswordStatusText" Text="Status: Using Default Admin Password (1111)" FontSize="13" Foreground="{StaticResource AccentGoldBrush}" Margin="0,0,0,14"/>

                    <Button Content="🔑 Change Parent Password" Style="{StaticResource OutlineButtonStyle}" HorizontalAlignment="Left" Padding="18,8" Click="ChangePassword_Click"/>
                </StackPanel>
            </Border>

            <!-- Web Dashboard Access Info Card -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="📱 Parent Web Dashboard Access" FontSize="16" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,4"/>
                    <TextBlock Text="Open this URL on your Phone, Tablet, or Laptop to manage this device remotely:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,14"/>

                    <Border Background="{StaticResource SurfaceDarkBrush}" Padding="14" CornerRadius="8" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="WebUrlDisplay" Grid.Column="0" Text="http://localhost:5000" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AccentBlueBrush}" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="📋 Copy URL" Style="{StaticResource OutlineButtonStyle}" Click="CopyWebUrl_Click"/>
                        </Grid>
                    </Border>

                    <TextBlock Text="💡 Note: Enter your Parent Username &amp; Password on the website to log in remotely." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- Preferences Card -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Application Preferences" FontSize="16" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,14"/>

                    <!-- Start with Windows -->
                    <CheckBox x:Name="StartWithWindowsCheck" Content="Launch Guardian protection automatically when Windows starts" Foreground="White" FontSize="13" Margin="0,0,0,12" Checked="StartWithWindows_Changed" Unchecked="StartWithWindows_Changed"/>

                    <!-- Minimize to Tray on Close -->
                    <CheckBox x:Name="MinimizeToTrayCheck" Content="Keep Guardian running in background system tray when window is closed" Foreground="White" FontSize="13" IsChecked="True" Margin="0,0,0,12" Checked="MinimizeToTray_Changed" Unchecked="MinimizeToTray_Changed"/>
                </StackPanel>
            </Border>

            <!-- Reset & Maintenance Card -->
            <Border Style="{StaticResource CardBorderStyle}" BorderBrush="{StaticResource DangerRedBrush}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Reset &amp; Maintenance" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource DangerRedBrush}" Margin="0,0,0,6"/>
                    <TextBlock Text="Reset today's usage counters for testing or calibration." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,14"/>

                    <WrapPanel>
                        <Button Content="🔄 Reset Today's Screen Time Usage" Style="{StaticResource OutlineButtonStyle}" Margin="0,0,12,0" Click="ResetUsage_Click"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
