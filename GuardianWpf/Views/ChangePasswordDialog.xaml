<Window x:Class="GuardianWpf.Views.ChangePasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Change Parent Password" Height="440" Width="460"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{StaticResource BgDarkBrush}">

    <Border BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" CornerRadius="16" Background="{StaticResource SurfaceDarkBrush}" Padding="28">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="🔑 Change Parent Password" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                <TextBlock Text="Create a secure personal administrator password." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Current Password -->
            <StackPanel Grid.Row="1" Margin="0,0,0,12">
                <TextBlock Text="Current Password" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                <PasswordBox x:Name="CurrentPasswordInput" Style="{StaticResource ModernPasswordBoxStyle}"/>
            </StackPanel>

            <!-- New Password -->
            <StackPanel Grid.Row="2" Margin="0,0,0,12">
                <TextBlock Text="New Password (min 4 characters)" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                <PasswordBox x:Name="NewPasswordInput" Style="{StaticResource ModernPasswordBoxStyle}"/>
            </StackPanel>

            <!-- Confirm New Password -->
            <StackPanel Grid.Row="3" Margin="0,0,0,8">
                <TextBlock Text="Confirm New Password" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                <PasswordBox x:Name="ConfirmPasswordInput" Style="{StaticResource ModernPasswordBoxStyle}"/>
            </StackPanel>

            <!-- Error Message -->
            <TextBlock x:Name="ErrorText" Grid.Row="4" Text="" FontSize="12" Foreground="{StaticResource DangerRedBrush}" Visibility="Collapsed" Margin="0,4,0,0"/>

            <!-- Buttons -->
            <Grid Grid.Row="6" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="Cancel" Style="{StaticResource OutlineButtonStyle}" Click="Cancel_Click"/>
                <Button Grid.Column="2" Content="Save Password" Style="{StaticResource PrimaryButtonStyle}" Click="Save_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
