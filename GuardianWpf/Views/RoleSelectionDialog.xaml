<Window x:Class="GuardianWpf.Views.RoleSelectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to Guardian" Height="440" Width="540"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{StaticResource BgDarkBrush}">

    <Border BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" CornerRadius="16" Background="{StaticResource SurfaceDarkBrush}" Padding="32">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,16">
                <TextBlock Text="🛡️ GUARDIAN" FontSize="26" FontWeight="Bold" Foreground="{StaticResource AccentBlueBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="Windows Parental Controls &amp; Digital Wellbeing" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>

            <TextBlock Grid.Row="1" Text="Who is setting up this computer?" FontSize="16" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,24"/>

            <!-- Role Choices -->
            <Grid Grid.Row="2" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Parent Option -->
                <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Background="{StaticResource CardDarkBrush}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="👨👩" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="Parent" FontSize="18" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                        <TextBlock Text="I manage this device and configure parental rules." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,16"/>
                        <Button Content="Set Up as Parent" Style="{StaticResource PrimaryButtonStyle}" Click="Parent_Click"/>
                    </StackPanel>
                </Border>

                <!-- Child Option -->
                <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Background="{StaticResource CardDarkBrush}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="👦👧" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="Child" FontSize="18" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                        <TextBlock Text="I use this device under configured parental rules." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,16"/>
                        <Button Content="Use as Child" Style="{StaticResource OutlineButtonStyle}" Click="Child_Click"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Default Password Notice -->
            <Border Grid.Row="3" Background="{StaticResource CardDarkBrush}" CornerRadius="8" Padding="10,6">
                <TextBlock Text="💡 Note: Default administrator password starts as 1111. You can change it anytime." FontSize="11" Foreground="{StaticResource AccentGoldBrush}" HorizontalAlignment="Center"/>
            </Border>
        </Grid>
    </Border>
</Window>
