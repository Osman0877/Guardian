<UserControl x:Class="GuardianWpf.Views.ApplicationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28">

            <Grid Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="🎮 Application Rules &amp; Limits" FontSize="24" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Block specific games/apps or set individual daily time allowances." FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Search Box -->
                <TextBox x:Name="SearchInput" Style="{StaticResource ModernTextBoxStyle}" Width="240" HorizontalAlignment="Right" VerticalAlignment="Center" TextChanged="SearchInput_TextChanged" Tag="Search applications..."/>
            </Grid>

            <!-- Add Custom App Card -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="140"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Process Name (e.g. notepad or robloxplayerbeta)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="NewProcessNameInput" Style="{StaticResource ModernTextBoxStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Display Name (e.g. Notepad)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="NewDisplayNameInput" Style="{StaticResource ModernTextBoxStyle}"/>
                    </StackPanel>

                    <Button Grid.Column="4" Content="➕ Add App" Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Bottom" Height="38" Click="AddApp_Click"/>
                </Grid>
            </Border>

            <!-- App Rules List -->
            <ItemsControl x:Name="AppRulesItemsControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="140"/>
                                </Grid.ColumnDefinitions>

                                <!-- App Title & Category -->
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DisplayName}" FontSize="16" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock Text="{Binding ProcessName}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <Border Background="{StaticResource SurfaceDarkBrush}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" Margin="0,4,0,0">
                                        <TextBlock Text="{Binding Category}" FontSize="10" Foreground="{StaticResource AccentGoldBrush}"/>
                                    </Border>
                                </StackPanel>

                                <!-- Daily Time Limit Slider -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0">
                                    <Grid>
                                        <TextBlock Text="Daily Limit:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding LimitDisplayString}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentBlueBrush}" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Slider Minimum="0" Maximum="240" Value="{Binding DailyLimitMinutes, Mode=TwoWay}" TickFrequency="15" IsSnapToTickEnabled="True" Margin="0,6,0,0" ValueChanged="LimitSlider_ValueChanged"/>
                                </StackPanel>

                                <!-- Block / Allow Toggle Button -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <Button Content="{Binding BlockButtonText}" Style="{Binding BlockButtonStyle}" Click="ToggleBlock_Click" Width="120" Margin="0,0,0,6"/>
                                    <Button Content="Remove" Style="{StaticResource OutlineButtonStyle}" Click="DeleteApp_Click" Width="120" Padding="8,4" FontSize="11"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
