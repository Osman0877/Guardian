<UserControl x:Class="GuardianWpf.Views.AfkLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28">

            <!-- Title Header -->
            <Grid Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="🕒 Parent AFK Log &amp; Session History" FontSize="24" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Persistent historical database of every parent-authorized AFK pause, exact timestamps, and durations." FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>

                <Button Content="📥 Export AFK Log (CSV)" Style="{StaticResource SuccessButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="14,8" Click="ExportCsv_Click"/>
            </Grid>

            <!-- AFK Log Summary Cards -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Today -->
                <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="TODAY'S AFK TIME" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock x:Name="AfkTimeTodayText" Text="0h 00m" FontSize="26" FontWeight="Bold" Foreground="{StaticResource SuccessGreenBrush}" Margin="0,6,0,2"/>
                        <TextBlock x:Name="AfkCountTodayText" Text="0 Sessions Today" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <!-- This Week -->
                <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="THIS WEEK'S AFK TIME" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock x:Name="AfkTimeWeekText" Text="0h 00m" FontSize="26" FontWeight="Bold" Foreground="{StaticResource AccentBlueBrush}" Margin="0,6,0,2"/>
                        <TextBlock x:Name="AfkCountWeekText" Text="0 Sessions This Week" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <!-- All Time -->
                <Border Grid.Column="4" Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="TOTAL ALL-TIME AFK" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock x:Name="AfkTimeTotalText" Text="0h 00m" FontSize="26" FontWeight="Bold" Foreground="White" Margin="0,6,0,2"/>
                        <TextBlock x:Name="AfkCountTotalText" Text="0 Total Sessions" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Active AFK Session Banner Card (Visible only when AFK is active) -->
            <Border x:Name="ActiveAfkCard" Style="{StaticResource CardBorderStyle}" Background="#1e3a29" BorderBrush="{StaticResource SuccessGreenBrush}" BorderThickness="1" Margin="0,0,0,24" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="🟢" FontSize="28" VerticalAlignment="Center" Margin="0,0,16,0"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="🟢 AFK MODE ACTIVE NOW" FontSize="16" FontWeight="Bold" Foreground="{StaticResource SuccessGreenBrush}"/>
                        <TextBlock x:Name="ActiveStartedText" Text="Started: September 19, 2026 at 6:42:13 PM" FontSize="13" Foreground="White" Margin="0,2,0,0"/>
                        <TextBlock x:Name="ActiveDurationText" Text="Current Duration: 1h 12m 08s" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                    </StackPanel>

                    <Border Grid.Column="2" Background="{StaticResource SurfaceDarkBrush}" CornerRadius="4" Padding="10,6" VerticalAlignment="Center">
                        <TextBlock Text="Status: Active" FontSize="12" FontWeight="Bold" Foreground="{StaticResource SuccessGreenBrush}"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Table Filters & Control Bar -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Filter by Date -->
                    <TextBlock Grid.Column="0" Text="📅 Date Filter:" FontSize="13" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox Grid.Column="1" x:Name="DateFilterCombo" Style="{StaticResource ModernComboBoxStyle}" Height="32" SelectionChanged="Filter_SelectionChanged">
                        <ComboBoxItem Content="All Time" IsSelected="True"/>
                        <ComboBoxItem Content="Today"/>
                        <ComboBoxItem Content="Yesterday"/>
                        <ComboBoxItem Content="Last 7 Days"/>
                        <ComboBoxItem Content="Last 30 Days"/>
                    </ComboBox>

                    <!-- Sort by -->
                    <TextBlock Grid.Column="3" Text="🔃 Sort By:" FontSize="13" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox Grid.Column="4" x:Name="SortCombo" Style="{StaticResource ModernComboBoxStyle}" Height="32" SelectionChanged="Filter_SelectionChanged">
                        <ComboBoxItem Content="Newest First" IsSelected="True"/>
                        <ComboBoxItem Content="Oldest First"/>
                        <ComboBoxItem Content="Longest Duration"/>
                        <ComboBoxItem Content="Shortest Duration"/>
                    </ComboBox>

                    <!-- Refresh Button -->
                    <Button Grid.Column="6" Content="🔄 Refresh" Style="{StaticResource OutlineButtonStyle}" Padding="12,4" Click="Refresh_Click"/>
                </Grid>
            </Border>

            <!-- AFK Sessions History ListView Table -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="Historical AFK Sessions" FontSize="16" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,14"/>

                    <ListView x:Name="AfkSessionsList" Background="Transparent" BorderThickness="0" Foreground="White" SelectionChanged="AfkSessionsList_SelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="0,0,0,1" Padding="10,12" Width="720">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Date -->
                                        <TextBlock Grid.Column="0" Text="{Binding FormattedStartDate}" FontSize="13" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>

                                        <!-- Started -->
                                        <TextBlock Grid.Column="1" Text="{Binding FormattedStartTime}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>

                                        <!-- Ended -->
                                        <TextBlock Grid.Column="2" Text="{Binding FormattedEndTime}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>

                                        <!-- Duration -->
                                        <TextBlock Grid.Column="3" Text="{Binding FormattedDuration}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource SuccessGreenBrush}" VerticalAlignment="Center"/>

                                        <!-- End Reason -->
                                        <Border Grid.Column="4" Background="{StaticResource SurfaceDarkBrush}" CornerRadius="4" Padding="6,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding EndReason}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentGoldBrush}"/>
                                        </Border>

                                        <!-- Actions: Details -->
                                        <Button Grid.Column="5" Content="🔍 Details" Style="{StaticResource OutlineButtonStyle}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="8,4" Click="SessionDetails_Click" Tag="{Binding}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock x:Name="NoSessionsText" Text="No AFK sessions recorded for the selected filter." FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,20,0,10" Visibility="Collapsed"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
