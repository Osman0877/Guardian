<UserControl x:Class="GuardianWpf.Views.AppBlockingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28">

            <Grid Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="📱 App Blocking &amp; Restrictions" FontSize="24" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Instantly block distracting games or social apps, or enforce daily time allowances." FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Search Input -->
                <TextBox x:Name="SearchBox" Style="{StaticResource ModernTextBoxStyle}" Width="240" HorizontalAlignment="Right" VerticalAlignment="Center" TextChanged="SearchBox_TextChanged" Tag="Filter apps..."/>
            </Grid>

            <!-- Quick Add App Card -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="140"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Process Executable Name (e.g. robloxplayerbeta or discord)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="ProcessInput" Style="{StaticResource ModernTextBoxStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Friendly Display Name" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="NameInput" Style="{StaticResource ModernTextBoxStyle}"/>
                    </StackPanel>

                    <Button Grid.Column="4" Content="➕ Add App" Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Bottom" Height="38" Click="AddApp_Click"/>
                </Grid>
            </Border>

            <!-- App Cards Grid / Items -->
            <ItemsControl x:Name="AppsItemsControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="160"/>
                                </Grid.ColumnDefinitions>

                                <!-- Title, Process Name, Category -->
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DisplayName}" FontSize="16" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock Text="{Binding ProcessName}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <Border Background="{StaticResource SurfaceDarkBrush}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" Margin="0,4,0,0">
                                        <TextBlock Text="{Binding Category}" FontSize="10" Foreground="{StaticResource AccentGoldBrush}"/>
                                    </Border>
                                </StackPanel>

                                <!-- Used Today & Limit Slider -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0">
                                    <Grid>
                                        <TextBlock Text="{Binding UsageStatusText}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding LimitDisplayText}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentBlueBrush}" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Slider Minimum="0" Maximum="240" Value="{Binding DailyLimitMinutes, Mode=TwoWay}" TickFrequency="15" IsSnapToTickEnabled="True" Margin="0,6,0,0" ValueChanged="Slider_ValueChanged"/>
                                </StackPanel>

                                <!-- Block / Allow Toggle -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <Button Content="{Binding BlockButtonText}" Style="{Binding BlockButtonStyle}" Width="140" Margin="0,0,0,6" Click="ToggleBlock_Click"/>
                                    <Button Content="Remove Rule" Style="{StaticResource OutlineButtonStyle}" Width="140" Padding="8,4" FontSize="11" Click="Delete_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
