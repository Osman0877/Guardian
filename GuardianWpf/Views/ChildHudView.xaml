<UserControl x:Class="GuardianWpf.Views.ChildHudView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{StaticResource BgDarkBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Child Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource SurfaceDarkBrush}" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="0,0,1,0" Padding="14,20">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="4,0,0,20">
                    <TextBlock x:Name="ChildAvatarText" Text="👦" FontSize="26" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="ChildGreetingText" Text="Hello, Alex!" FontSize="15" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Child Mode" FontSize="11" Foreground="{StaticResource AccentBlueBrush}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Navigation Tabs -->
                <RadioButton x:Name="ChildNavHome" Content="🏠  Home" Style="{StaticResource NavButtonStyle}" IsChecked="True" Click="ChildNav_Click"/>
                <RadioButton x:Name="ChildNavTime" Content="⏰  My Screen Time" Style="{StaticResource NavButtonStyle}" Click="ChildNav_Click"/>
                <RadioButton x:Name="ChildNavApps" Content="📱  My Apps" Style="{StaticResource NavButtonStyle}" Click="ChildNav_Click"/>
                <RadioButton x:Name="ChildNavRequests" Content="📨  My Requests" Style="{StaticResource NavButtonStyle}" Click="ChildNav_Click"/>
                <RadioButton x:Name="ChildNavNotifs" Content="🔔  Notifications" Style="{StaticResource NavButtonStyle}" Click="ChildNav_Click"/>
            </StackPanel>
        </Border>

        <!-- Child Main Content -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32">

                <!-- Header -->
                <Grid Margin="0,0,0,24">
                    <StackPanel>
                        <TextBlock Text="Welcome Back! 👋" FontSize="26" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Check your remaining time today and ask your parents for permission." FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <Button Content="📩 Ask for More Time" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="18,10" Click="RequestTime_Click"/>
                </Grid>

                <!-- AFK Mode Active Banner (Child UI) -->
                <Border x:Name="ChildAfkBanner" Style="{StaticResource CardBorderStyle}" Background="#1e3a29" BorderBrush="{StaticResource SuccessGreenBrush}" BorderThickness="1" Margin="0,0,0,24" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="🟢" FontSize="26" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="AFK Mode is currently active." FontSize="16" FontWeight="Bold" Foreground="{StaticResource SuccessGreenBrush}"/>
                            <TextBlock x:Name="ChildAfkText" Text="Screen-time accounting is paused." FontSize="13" Foreground="White" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Screen Time Cards -->
                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Background="{StaticResource SurfaceDarkBrush}" BorderBrush="{StaticResource SuccessGreenBrush}">
                        <StackPanel>
                            <TextBlock Text="REMAINING TIME TODAY" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock x:Name="RemainingText" Text="1h 45m" FontSize="36" FontWeight="Bold" Foreground="{StaticResource SuccessGreenBrush}" Margin="0,8,0,4"/>
                            <TextBlock x:Name="BedtimeNoticeText" Text="Bedtime is at 9:30 PM" FontSize="12" Foreground="{StaticResource AccentGoldBrush}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="USED TIME TODAY" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock x:Name="UsedText" Text="0h 15m" FontSize="36" FontWeight="Bold" Foreground="White" Margin="0,8,0,4"/>
                            <ProgressBar x:Name="UsageBar" Height="8" Maximum="100" Value="15" Foreground="{StaticResource AccentBlueBrush}" Background="{StaticResource SurfaceDarkBrush}" BorderThickness="0" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Allowed Applications List -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="My Games &amp; Applications" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,14"/>

                        <ListView x:Name="ChildAppsListView" Background="Transparent" BorderThickness="0" Foreground="White">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="0,0,0,1" Padding="8,12" Width="640">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="200"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="130"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}" FontSize="15" FontWeight="SemiBold" Foreground="White"/>
                                                <TextBlock Text="{Binding Category}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                                                <Grid>
                                                    <TextBlock Text="Used:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                    <TextBlock Text="{Binding UsageAndLimitText}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBlueBrush}" HorizontalAlignment="Right"/>
                                                </Grid>
                                                <ProgressBar Value="{Binding UsagePercent}" Maximum="100" Height="6" Background="{StaticResource SurfaceDarkBrush}" Foreground="{Binding ProgressBrush}" BorderThickness="0" Margin="0,4,0,0"/>
                                            </StackPanel>

                                            <Border Grid.Column="2" Background="{Binding BadgeBackground}" CornerRadius="4" Padding="8,4" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding StatusBadgeText}" FontSize="11" FontWeight="Bold" Foreground="{Binding BadgeForeground}"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
